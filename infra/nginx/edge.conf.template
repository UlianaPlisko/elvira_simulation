# infra/nginx/edge.conf.template
user  nginx;
worker_processes  auto;
error_log  /var/log/nginx/error.log warn;
pid        /var/run/nginx.pid;

events { worker_connections 1024; }

http {
    upstream central_elvira {
        server 172.20.0.2:80;
    }

    log_format edge '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" "$http_user_agent" '
                    'cache="$upstream_cache_status" xff="$http_x_forwarded_for"';

    access_log /var/log/nginx/access.log edge;

    proxy_cache_path /var/cache/nginx/elvira_cache levels=1:2 keys_zone=elvira_cache:50m max_size=500m inactive=60m use_temp_path=off;

    server {
        listen 80;
        server_name elvira.lib;

        location = /stub_status {
            stub_status;
            access_log off;
        }

        location /books/ {
            proxy_cache elvira_cache;
            proxy_cache_key "$scheme$proxy_host$request_uri";
            proxy_cache_valid 200 302 1h;
            proxy_cache_valid 404 1m;
            proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
            add_header X-Cache-Status $upstream_cache_status;

            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            proxy_connect_timeout 5s;
            proxy_read_timeout 30s;

            # gunzip вставляется как on/off строка (подставится через envsubst)
            gunzip ${GUNZIP_SETTING};
            gunzip_buffers 32 4k;

            proxy_pass http://central_elvira;
        }

        location / {
            root /usr/share/nginx/html;
            index index.html index.htm;
        }
    }
}
