# infra/nginx/central.conf.template
user  nginx;
worker_processes  auto;
error_log  /var/log/nginx/error.log warn;
pid        /var/run/nginx.pid;

events { worker_connections 1024; }

http {

    include /etc/nginx/mime.types;
    default_type application/pdf;

    set_real_ip_from 172.20.0.0/16;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    log_format elvira '$remote_addr - $remote_user [$time_local] "$request" '
                      '$status $body_bytes_sent "$http_referer" "$http_user_agent" '
                      'xff="$http_x_forwarded_for" xrip="$http_x_real_ip"';

    access_log /var/log/nginx/access.log elvira;

    server {
        listen 80 default_server;
        server_name central.elvira.lib elvira.lib;

        location = /stub_status {
            stub_status;
            access_log off;
            allow 127.0.0.1;
            allow 172.20.0.0/16;
            deny  all;
        }

        root /var/www/elvira;
        index index.html index.htm;

        location /books/ {
            alias ${BOOKS_ALIAS};
            autoindex off;
            try_files $uri $uri/ =404;

            set $content_enc '${CONTENT_ENCODING}';
            if ($content_enc != '') {
                add_header Content-Encoding $content_enc;
                add_header Vary Accept-Encoding;
            }
        }

        location /health {
            proxy_pass http://127.0.0.1:3100/health;
        }
    }
}
