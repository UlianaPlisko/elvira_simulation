.:53 {
    errors
    log
    prometheus :9153
    health :8080  # Optional health check endpoint
}

elvira.lib:53 {
    ecs {
        fallthrough  # Continue to next plugin even if no ECS
    }
    template IN A elvira.lib. {
        match .*
        answer "{{ if hasPrefix (index .Metadata \"ecs/subnet\") \"192.168.1.\" }}172.20.0.10 elvira.lib{{ else }}172.20.0.2 elvira.lib{{ end }}"
        ttl 300
    }
    log
    errors
}