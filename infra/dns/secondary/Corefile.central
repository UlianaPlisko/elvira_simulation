elvira.lib:53 {
    ecs {
        mask_v4 24
    }
    metadata
    template IN A elvira.lib. {
        match .*
        answer "{{ .Name }} 300 IN A 172.20.0.2"
        additional "{{ .Name }} 300 IN TXT mode: central-only"
        fallthrough
    }
    template IN AAAA elvira.lib. {
        match .*
        rcode NOERROR
        fallthrough
    }
    log
    errors
}

.:53 {
    errors
    log
    prometheus :9153
    health :8080
    forward . 8.8.8.8
}